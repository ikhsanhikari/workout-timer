# ── Production Keystore Configuration Template ──────────────────────────────
#
# CARA PENGGUNAAN:
# 1. Salin file ini menjadi 'keystore.properties' di root folder proyek:
#    cp keystore.properties.example keystore.properties
# 2. Jika belum memiliki keystore release, buat menggunakan perintah keytool:
#    keytool -genkey -v -keystore release.keystore -alias workout-release -keyalg RSA -keysize 2048 -validity 10000
# 3. Isi informasi di bawah ini sesuai keystore Anda.
#
# PERINGATAN KEAMANAN:
# Jangan pernah commit file 'keystore.properties' atau file '*.keystore / *.jks' ke repository Git!
# File ini sudah didaftarkan di .gitignore untuk mencegah kebocoran kredensial.

storeFile=release.keystore
storePassword=your_keystore_password_here
keyAlias=workout-release
keyPassword=your_key_password_here

